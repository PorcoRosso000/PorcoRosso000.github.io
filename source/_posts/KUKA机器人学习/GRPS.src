&ACCESS RV1
DEF GRPS ( )
;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
  ;FOLD USER INI
    ;Make your modifications here

  ;ENDFOLD (USER INI)
;ENDFOLD (INI)



END
GLOBAL DEF  GRPS_DIANJI_OPEN ()
WAIT SEC 0
$TIMER[50]=-5000
$TIMER_STOP[50]=FALSE
$OUT[3]=FALSE
$OUT[4]=TRUE
WAIT SEC 0.1
WAIT FOR (NOT $IN[4]) AND $IN[3]
WAIT SEC 0.5
$TIMER_STOP[50]=TRUE
$TIMER[50]=-5000
END
GLOBAL DEF GRPS_DIANJI_CLOSE ()
WAIT SEC 0
$TIMER[50]=-5000
$TIMER_STOP[50]=FALSE

$OUT[4]=FALSE
$OUT[3]=TRUE
WAIT SEC 0.1
WAIT FOR (NOT $IN[3]) AND $IN[4]
WAIT SEC 0.5
$TIMER_STOP[50]=TRUE
$TIMER[50]=-5000

END
GLOBAL DEF GRPS_TUOPAN_OPEN ()
WAIT SEC 0
$TIMER[50]=-5000
$TIMER_STOP[50]=FALSE

$OUT[2]=FALSE
$OUT[1]=TRUE
WAIT SEC 0.1
WAIT FOR (NOT $IN[2]) AND $IN[1]
WAIT SEC 0.5
$TIMER_STOP[50]=TRUE
$TIMER[50]=-5000

END
GLOBAL DEF GRPS_TUOPAN_CLOSE ()
WAIT SEC 0
$TIMER[50]=-5000
$TIMER_STOP[50]=FALSE
$OUT[1]=FALSE
$OUT[2]=TRUE
WAIT SEC 0.1
WAIT FOR (NOT $IN[1]) AND $IN[2]
WAIT SEC 0.5
$TIMER_STOP[50]=TRUE
$TIMER[50]=-5000

END

